{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/public/*", "/*.{png,jpg,jpeg,gif,svg,ico,json,css,js}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ]
}
